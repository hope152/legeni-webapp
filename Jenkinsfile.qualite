pipeline {
    agent any

    environment {
        IMAGE   = "touffa/legeni-webapp"
        VERSION = "1.0.${env.BUILD_NUMBER}"
    }

    stages {
        stage('Qualité du code') {
            parallel {
                stage('Tests unitaires') {
                    agent {
                        docker { image 'python:3.12-slim'; args '-e HOME=/tmp'; reuseNode true }
                    }
                    steps {
                        sh '''
                            pip install -r requirements.txt -r requirements-dev.txt
                            pytest --junitxml=reports/junit.xml --cov=app --cov-report=xml:reports/coverage.xml
                        '''
                    }
                    post {
                        always {
                            junit 'reports/junit.xml'
                        }
                    }
                }
                stage('Lint Python') {
                    agent {
                        docker { image 'python:3.12-slim'; args '-e HOME=/tmp'; reuseNode true }
                    }
                    steps {
                        sh '''
                            pip install flake8==7.1.1
                            flake8 --output-file=reports/flake8.txt --tee . || true
                        '''
                    }
                }
            }
        }

        stage('Build image') {
            steps {
                sh 'docker build --build-arg APP_VERSION=$VERSION -t $IMAGE:$VERSION .'
            }
        }

        stage('Scan de sécurité') {
            steps {
                sh '''
                    docker run --rm -v /var/run/docker.sock:/var/run/docker.sock -v trivy_cache:/root/.cache \
                        aquasec/trivy:0.57.1 image --severity CRITICAL --ignore-unfixed --exit-code 0 $IMAGE:$VERSION
                '''
            }
        }
    }
}
